# Global default: text files auto-align to LF in working copy
* text=auto eol=lf

# Backend C# files
*.cs text diff=csharp eol=lf

# Infrastructure, Scripts, and Configuration
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.config text eol=lf
*.editorconfig text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
[Dd]ockerfile* text eol=lf

# Windows Batch scripts (require CRLF to execute properly)
*.bat text eol=crlf
*.cmd text eol=crlf

# Visual Studio & Solution files
*.sln text eol=lf
*.slnx text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf

# Binary file handling
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.gif binary
*.dll binary
*.exe binary
